{
  "contract": "gsd-lexicon-1",
  "about": "The known types every law is read against (the operator, 2026-11-25 12:03: \"all laws should instead carry multiple scores/probabilities vs all known phenotypes and how similar they are to the other phenotypes, a giant matrix 2d\"). A type is one geometry of the calibration table, made of the families that build it; two families that build the same geometry two ways are one type, because the readings cannot tell them apart. A law's distance to a type is the root mean square, over the readings both have, of how many of the type's own spreads apart they are, at the size nearest the law's. A law further than new_zone_beyond from every type is near none of them: the sign of a new zone.",
  "features": ["d_s", "d_V", "d_B", "d_w", "mean_degree", "giant"],
  "floors": {"d_s": 0.05, "d_V": 0.05, "d_B": 0.05, "d_w": 0.05, "mean_degree": 0.05, "giant": 0.02},
  "relative": ["mean_degree"],
  "refused_apart": 3.0,
  "most_apart": 10.0,
  "refused_from_share": 0.5,
  "sizes_within": 0.75,
  "new_zone_beyond": 3.0,
  "held_out_from_seed": 7,
  "known_answers_from_n": 1000,
  "types": {
    "ring": ["periodic_ring"],
    "square lattice": ["periodic_square_lattice"],
    "triangular lattice": ["periodic_triangular_lattice"],
    "honeycomb lattice": ["periodic_honeycomb_lattice"],
    "cubic lattice": ["periodic_cubic_lattice", "periodic_cubic_quotient"],
    "body-centred cubic lattice": ["periodic_body_centred_cubic_lattice"],
    "face-centred cubic lattice": ["periodic_face_centred_cubic_lattice"],
    "4D hypercubic lattice": ["periodic_hypercubic_lattice_4d", "periodic_tesseract_quotient"],
    "A4 lattice": ["periodic_a4_lattice"],
    "D4 lattice": ["periodic_d4_lattice"],
    "Sierpinski carpet": ["sierpinski_carpet"],
    "Sierpinski gasket": ["sierpinski_gasket"],
    "tree": ["balanced_binary_tree", "uniform_random_tree"],
    "random graph, degree 2": ["erdos_renyi_degree_2"],
    "random graph, degree 2.5": ["erdos_renyi_sparse"],
    "random graph, degree 3": ["erdos_renyi_mid"],
    "random graph, degree 4": ["erdos_renyi_dense"],
    "random graph, degree 6": ["erdos_renyi_degree_6"],
    "random graph, degree 16": ["erdos_renyi_degree_16"],
